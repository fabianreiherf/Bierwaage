            ".validate": "newData.hasChildren(['c','t'])",
            "c": {
              ".validate": "newData.isString() && newData.val().length === 6 && newData.val().matches(/^[A-Z0-9]+$/)"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
            },
            "a": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
